generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String        @id @default(cuid())
  companyName   String
  brandName     String
  website       String
  domain        String
  aliases       String        @default("[]") // JSON string[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  competitors   Competitor[]
  prompts       Prompt[]
  runs          MonitoringRun[]
  pages         ContentPage[]
  agentRuns     AgentRun[]
  schedule      Schedule?
}

model Competitor {
  id        String  @id @default(cuid())
  projectId String
  name      String
  domain    String?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Prompt {
  id        String         @id @default(cuid())
  projectId String
  text      String
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results   SearchResult[]

  @@index([projectId])
}

model MonitoringRun {
  id          String         @id @default(cuid())
  projectId   String
  provider    String // "openai" | "gemini" | "all"
  status      String // running | completed | failed
  trigger     String         @default("manual") // manual | agent
  agentRunId  String?
  error       String?
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results     SearchResult[]

  @@index([projectId, startedAt])
}

model SearchResult {
  id              String        @id @default(cuid())
  monitoringRunId String
  promptId        String
  provider        String // openai | gemini
  model           String
  answer          String
  status          String // ok | error
  error           String?
  targetMentioned Boolean       @default(false)
  uncertain       Boolean       @default(false)
  mentionedBrands String        @default("[]") // JSON string[]
  targetPosition  Int?
  timestamp       DateTime      @default(now())
  run             MonitoringRun @relation(fields: [monitoringRunId], references: [id], onDelete: Cascade)
  prompt          Prompt        @relation(fields: [promptId], references: [id], onDelete: Cascade)
  citations       Citation[]

  @@index([monitoringRunId])
  @@index([promptId])
}

model Citation {
  id             String       @id @default(cuid())
  searchResultId String
  url            String
  domain         String
  title          String?
  result         SearchResult @relation(fields: [searchResultId], references: [id], onDelete: Cascade)

  @@index([searchResultId])
  @@index([domain])
}

model ContentPage {
  id             String                @id @default(cuid())
  projectId      String
  url            String
  title          String?
  analysis       String? // JSON
  extracted      String? // JSON of extracted content
  lastAnalyzedAt DateTime?
  createdAt      DateTime              @default(now())
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  optimizations  ContentOptimization[]

  @@unique([projectId, url])
}

model ContentOptimization {
  id              String      @id @default(cuid())
  contentPageId   String
  originalHtml    String
  optimizedHtml   String
  recommendations String // JSON
  changes         String // JSON
  summary         String?
  trigger         String      @default("manual")
  createdAt       DateTime    @default(now())
  page            ContentPage @relation(fields: [contentPageId], references: [id], onDelete: Cascade)

  @@index([contentPageId, createdAt])
}

model AgentRun {
  id            String    @id @default(cuid())
  projectId     String
  status        String // running | completed | failed
  trigger       String // manual | cron
  periodKey     String? // e.g. 2026-W46 for idempotent weekly runs
  executionLogs String    @default("[]") // JSON steps
  summary       String? // JSON weekly summary
  error         String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, periodKey])
  @@index([projectId, startedAt])
}

model Schedule {
  id             String    @id @default(cuid())
  projectId      String    @unique
  cronExpression String    @default("0 9 * * 1")
  timezone       String    @default("Asia/Seoul")
  enabled        Boolean   @default(true)
  lastRunAt      DateTime?
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
