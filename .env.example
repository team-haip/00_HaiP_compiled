OPENAI_API_KEY=
GEMINI_API_KEY=
DATABASE_URL="file:./dev.db"
CRON_SECRET=
APP_BASE_URL=http://localhost:3000

# Optional: override model ids (defaults follow the official docs at time of writing)
OPENAI_MODEL=gpt-6-astra
GEMINI_MODEL=gemini-3.8-flash

# Set to 1 to force demo mode (clearly labeled sample answers, no API calls).
# Demo mode is also used automatically when both API keys are empty.
DEMO_MODE=
